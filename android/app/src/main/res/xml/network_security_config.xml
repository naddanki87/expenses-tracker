<?xml version="1.0" encoding="utf-8"?>
<!--
  The backend is a single-user server without TLS (architecture A12). The Settings screen lets the
  user point the app at any LAN address, so cleartext HTTP cannot be limited to 10.0.2.2.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
