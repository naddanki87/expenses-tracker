<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/listFragment">

    <fragment
        android:id="@+id/listFragment"
        android:name="com.factory.expenses.ui.list.ListFragment"
        android:label="@string/nav_expenses">
        <action
            android:id="@+id/action_list_to_edit"
            app:destination="@id/editFragment" />
    </fragment>

    <fragment
        android:id="@+id/editFragment"
        android:name="com.factory.expenses.ui.edit.EditFragment"
        android:label="@string/title_edit" />

    <fragment
        android:id="@+id/summaryFragment"
        android:name="com.factory.expenses.ui.summary.SummaryFragment"
        android:label="@string/nav_summary" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.factory.expenses.ui.settings.SettingsFragment"
        android:label="@string/nav_settings" />
</navigation>
